{
  "hostId": "ubuntu-dev-main",
  "storageDir": "./runtime",
  "channels": {
    "feishu": {
      "enabled": true,
      "appId": "replace-me",
      "appSecret": "replace-me",
      "mode": "websocket",
      "apiBaseUrl": "https://open.feishu.cn",
      "websocketUrl": "wss://msg-frontier.feishu.cn/ws/v2",
      "reconnectIntervalMs": 5000,
      "bindHost": "0.0.0.0",
      "port": 8787,
      "path": "/feishu/events",
      "verificationToken": "replace-me"
    },
    "weixin": {
      "enabled": true,
      "gatewayBaseUrl": "http://127.0.0.1:3000",
      "token": "replace-me",
      "accountId": "replace-me"
    }
  },
  "agents": {
    "codex": {
      "enabled": true,
      "command": "codex",
      "defaultProfile": "dev-main"
    },
    "claude": {
      "enabled": true,
      "command": "claude",
      "defaultProfile": "dev-main"
    },
    "gemini": {
      "enabled": false,
      "command": "gemini",
      "defaultProfile": "research"
    }
  },
  "personas": {
    "dev-control": {
      "allowedAgents": ["codex", "claude", "gemini"],
      "policy": "guarded-dev"
    },
    "daily-assistant": {
      "allowedAgents": ["claude"],
      "policy": "safe-chat"
    }
  },
  "projects": [
    {
      "id": "pocket-agent-hub",
      "path": "/home/cwl/Project/Github/pocket-agent-hub",
      "description": "The mobile agent hub repository.",
      "defaultAgent": "codex"
    },
    {
      "id": "soms",
      "path": "/home/cwl/Project/ltwl/travel/scenic_operations_management_system",
      "description": "The scenic operations monorepo.",
      "defaultAgent": "codex"
    }
  ]
}
